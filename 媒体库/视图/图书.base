filters:
  and:
    - file.inFolder("媒体库/作品")
    - note_type == "media"
    - media_type == "book"
formulas:
  year: if(release_date, release_date.toString().slice(0, 4), "未知")
  rating_label: if(rating, rating.toString() + " ★", "未评分")
  progress_label: if(status == "进行中", current_page.toString() + " / " + if(page_count, page_count.toString(), "?") + " 页", "")
properties:
  title:
    displayName: 书名
  authors:
    displayName: 作者
  genres:
    displayName: 类型
  release_date:
    displayName: 出版时间
  status:
    displayName: 状态
  formula.rating_label:
    displayName: 我的评分
  formula.progress_label:
    displayName: 进度
views:
  - type: cards
    name: 全部
    order:
      - title
      - authors
      - status
      - formula.rating_label
      - formula.progress_label
      - formula.year
    sort:
      - property: added_at
        direction: DESC
    image: cover
    imageFit: contain
    imageAspectRatio: 1.45
    cardSize: 170
  - type: cards
    name: 待阅读
    filters:
      and:
        - status == "待体验"
    order:
      - title
      - authors
      - formula.year
    sort:
      - property: added_at
        direction: DESC
    image: cover
    imageFit: contain
    imageAspectRatio: 1.45
    cardSize: 170
  - type: cards
    name: 阅读中
    filters:
      and:
        - status == "进行中"
    order:
      - title
      - formula.progress_label
      - formula.rating_label
    sort:
      - property: started_at
        direction: DESC
    image: cover
    imageFit: contain
    imageAspectRatio: 1.45
    cardSize: 170
  - type: cards
    name: 已完成
    filters:
      and:
        - status == "已完成"
    order:
      - title
      - authors
      - formula.rating_label
      - finished_at
    sort:
      - property: finished_at
        direction: DESC
    image: cover
    imageFit: contain
    imageAspectRatio: 1.45
    cardSize: 170
  - type: cards
    name: 高分
    filters:
      and:
        - rating >= 4
    order:
      - title
      - authors
      - formula.rating_label
      - formula.year
    sort:
      - property: rating
        direction: DESC
    image: cover
    imageFit: contain
    imageAspectRatio: 1.45
    cardSize: 170
  - type: table
    name: 管理表格
    order:
      - title
      - authors
      - genres
      - release_date
      - page_count
      - current_page
      - status
      - rating
      - favorite
      - series
      - collections
