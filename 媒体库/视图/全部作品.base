filters:
  and:
    - file.inFolder("媒体库/作品")
    - note_type == "media"
formulas:
  type_label: if(media_type == "book", "图书", if(media_type == "tv", "电视剧", if(media_type == "movie", "电影", if(media_type == "anime", "动漫", "游戏"))))
  rating_label: if(rating, rating.toString() + " ★", "未评分")
  progress_label: if(media_type == "book" && status == "进行中", current_page.toString() + " / " + if(page_count, page_count.toString(), "?") + " 页", if((media_type == "tv" || media_type == "anime") && status == "进行中", current_episode.toString() + " / " + if(episode_count, episode_count.toString(), "?") + " 集", if(media_type == "movie" && status == "进行中", if(current_minutes, current_minutes.toString(), "0") + " / " + if(runtime_minutes, runtime_minutes.toString().replace("分钟", ""), "?") + " 分", if(media_type == "game" && status == "进行中", progress_percent.toString() + "%", ""))))
views:
  - type: cards
    name: 最近加入
    order:
      - title
      - formula.type_label
      - status
      - formula.rating_label
    sort:
      - property: added_at
        direction: DESC
    image: cover
    imageFit: contain
    imageAspectRatio: 1.45
    cardSize: 160
  - type: cards
    name: 进行中
    filters:
      and:
        - status == "进行中"
    order:
      - title
      - formula.type_label
      - formula.progress_label
      - formula.rating_label
    sort:
      - property: file.mtime
        direction: DESC
      - property: added_at
        direction: DESC
    limit: 8
    image: cover
    imageFit: contain
    imageAspectRatio: 1.45
    cardSize: 160
