filters:
  and:
    - file.inFolder("媒体库/作品")
    - note_type == "media"
    - media_type == "movie"
formulas:
  year: if(release_date, release_date.toString().slice(0, 4), "未知")
  rating_label: if(rating, rating.toString() + " ★", "未评分")
  progress_label: if(status == "进行中", if(current_minutes, current_minutes.toString(), "0") + " / " + if(runtime_minutes, runtime_minutes.toString().replace("分钟", ""), "?") + " 分", "")
properties:
  title:
    displayName: 电影名
  genres:
    displayName: 类型
  release_date:
    displayName: 上映时间
  runtime_minutes:
    displayName: 时长
  status:
    displayName: 状态
  formula.rating_label:
    displayName: 我的评分
  formula.progress_label:
    displayName: 进度
views:
  - type: cards
    name: 全部
    order:
      - title
      - status
      - formula.rating_label
      - formula.year
      - runtime_minutes
    sort:
      - property: added_at
        direction: DESC
    image: cover
    imageFit: contain
    imageAspectRatio: 1.45
    cardSize: 170
  - type: cards
    name: 待观看
    filters:
      and:
        - status == "待体验"
    order:
      - title
      - genres
      - formula.year
    sort:
      - property: added_at
        direction: DESC
    image: cover
    imageFit: contain
    imageAspectRatio: 1.45
    cardSize: 170
  - type: cards
    name: 观看中
    filters:
      and:
        - status == "进行中"
    order:
      - title
      - formula.progress_label
      - formula.rating_label
      - runtime_minutes
    sort:
      - property: file.mtime
        direction: DESC
    image: cover
    imageFit: contain
    imageAspectRatio: 1.45
    cardSize: 170
  - type: cards
    name: 已完成
    filters:
      and:
        - status == "已完成"
    order:
      - title
      - formula.rating_label
    sort:
      - property: file.mtime
        direction: DESC
    image: cover
    imageFit: contain
    imageAspectRatio: 1.45
    cardSize: 170
  - type: cards
    name: 高分
    filters:
      and:
        - rating >= 4
    order:
      - title
      - formula.rating_label
      - genres
      - formula.year
    sort:
      - property: rating
        direction: DESC
    image: cover
    imageFit: contain
    imageAspectRatio: 1.45
    cardSize: 170
  - type: table
    name: 管理表格
    order:
      - title
      - genres
      - release_date
      - runtime_minutes
      - current_minutes
      - status
      - rating
      - favorite
      - series
      - collections
